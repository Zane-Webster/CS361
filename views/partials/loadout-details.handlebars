<div class="loadout-details">
    <div class="loadout-stats">
        <div class="bold">{{name}}</div>
        <div>Kills: {{performance.kills}}</div>
        <div>Downs: {{performance.downs}}</div>
        <div>Cost: ${{cost}}</div>

        <div class="bold">Profit: ${{profit}}</div>
        <div>Assists: {{performance.assists}}</div>
        <div>Revives: {{performance.revives}}</div>
        <div>Earned: ${{performance.moneyEarned}}</div>
    </div>

    <a class="loadout-edit" href="/loadouts/{{id}}/edit">EDIT</a>

    <form action="/loadouts/{{id}}/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this loadout?');">
        <button type="submit" class="loadout-delete">DELETE</button>
    </form>
</div>