<label for="{{id}}">{{label}}</label>
<div class="item-picker">
    <select id="{{id}}">
        <option value="">None</option>
        {{#each options}}
        <option value="{{name}}">{{name}} - ${{cost}}</option>
        {{/each}}
    </select>
    <button type="button" onclick="addItem('{{id}}', '{{listId}}', '{{inputName}}')" class="add-item">+</button>
</div>
<div id="{{listId}}"></div>