<h1>ADD A NEW LOADOUT</h1>

<form action="/loadouts" method="POST">
    {{> grouped-dropdown-add
        label="Primary Weapon"
        id="primaryWeapon"
        listId="primaryWeaponList"
        inputName="primaryWeapons"
        groups=primaryWeaponGroups
    }}

    {{> grouped-dropdown-add
        label="Secondary Weapon"
        id="secondaryWeapon"
        listId="secondaryWeaponList"
        inputName="secondaryWeapons"
        groups=secondaryWeaponGroups
    }}

    {{> grouped-dropdown-add
        label="Equipment"
        id="equipment"
        listId="equipmentList"
        inputName="equipment"
        groups=equipmentGroups
    }}

    {{> dropdown-add
        label="Parachute"
        id="parachute"
        listId="parachuteList"
        inputName="parachutes"
        options=parachutes
    }}

    {{> dropdown-add
        label="Helmet"
        id="helmet"
        listId="helmetList"
        inputName="helmets"
        options=helmets
    }}

    {{> dropdown-add
        label="Armor"
        id="armor"
        listId="armorList"
        inputName="armor"
        options=armor
    }}

    {{> dropdown-add
        label="Vest"
        id="vest"
        listId="vestList"
        inputName="vests"
        options=vests
    }}

    {{> dropdown-add
        label="Backpack"
        id="backpack"
        listId="backpackList"
        inputName="backpacks"
        options=backpacks
    }}

    {{> grouped-dropdown-add
        label="Vehicle"
        id="vehicle"
        listId="vehicleList"
        inputName="vehicles"
        groups=vehicleGroups
    }}

    <button type="submit" class="submit-add">SUBMIT LOADOUT</button>
</form>