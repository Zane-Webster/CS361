<script src="/js/tags.js" defer></script>
<script src="/js/selected-items.js" defer></script>
<script src="/js/edit-loadout.js" defer></script>

<script id="loadout-data" type="application/json">
    {{{loadoutJson}}}
</script>

<form
    action="{{#if isEditing}}/loadouts/{{loadout.id}}/edit{{else}}/loadouts{{/if}}"
    method="POST"
    class="edit-loadout"
>
    <!--
        NAME
    -->
    <section id="loadout-name">
        <input
            type="text"
            name="name"
            value="{{loadout.name}}"
            placeholder="Enter Loadout Name..."
            required
        >
    </section>

    <!--
        TAGS
    -->
    <section id="loadout-tags">
        <div id="loadout-tags-left">
            <h2>TAGS</h2>
            <input type="text" id="tag-input" placeholder="Enter Tag...">
            <button type="button" id="add-tag">+</button>
        </div>

        <ul id="tag-list"></ul>
    </section>

    <!--
        ADD ITEMS
    -->
    <section id="add-items">
        {{> grouped-dropdown-add
            label="Primary Weapon"
            id="primaryWeapon"
            listId="primaryWeaponList"
            inputName="primaryWeapons"
            groups=primaryWeaponGroups
        }}

        {{> grouped-dropdown-add
            label="Secondary Weapon"
            id="secondaryWeapon"
            listId="secondaryWeaponList"
            inputName="secondaryWeapons"
            groups=secondaryWeaponGroups
        }}

        {{> grouped-dropdown-add
            label="Equipment"
            id="equipment"
            listId="equipmentList"
            inputName="equipment"
            groups=equipmentGroups
        }}

        {{> dropdown-add
            label="Parachute"
            id="parachute"
            listId="parachuteList"
            inputName="parachutes"
            options=parachutes
        }}

        {{> dropdown-add
            label="Helmet"
            id="helmet"
            listId="helmetList"
            inputName="helmets"
            options=helmets
        }}

        {{> dropdown-add
            label="Armor"
            id="armor"
            listId="armorList"
            inputName="armor"
            options=armor
        }}

        {{> dropdown-add
            label="Vest"
            id="vest"
            listId="vestList"
            inputName="vests"
            options=vests
        }}

        {{> dropdown-add
            label="Backpack"
            id="backpack"
            listId="backpackList"
            inputName="backpacks"
            options=backpacks
        }}

        {{> grouped-dropdown-add
            label="Vehicle"
            id="vehicle"
            listId="vehicleList"
            inputName="vehicles"
            groups=vehicleGroups
        }}
    </section>

    <!--
        SELECTED ITEMS
    -->
    <section id="selected-items">
        <ul id="item-list"></ul>
    </section>

    <!--
        PERFORMANCE
    -->
    <section id="record-performance">
        <h1>PERFORMANCE</h1>
        <label>
            Kills
            <input type="number" id="kills-input" name="kills" value="{{#if isEditing}}{{loadout.performance.kills}}{{else}}0{{/if}}">
        </label>

        <label>
            Assists
            <input type="number" id="assists-input" name="assists" value="{{#if isEditing}}{{loadout.performance.assists}}{{else}}0{{/if}}">
        </label>

        <label>
            Downs
            <input type="number" id="downs-input" name="downs" value="{{#if isEditing}}{{loadout.performance.downs}}{{else}}0{{/if}}">
        </label>
        
        <label>
            Revives
            <input type="number" id="revives-input" name="revives" value="{{#if isEditing}}{{loadout.performance.revives}}{{else}}0{{/if}}">
        </label>

        <label>
            Money Earned
            <input type="number" id="money-earned-input" name="money-earned" value="{{#if isEditing}}{{loadout.performance.moneyEarned}}{{else}}0{{/if}}">
        </label>

        <label>
            Minutes Survived
            <input type="number" id="mins-survived-input" name="mins-survived" value="{{#if isEditing}}{{loadout.performance.minutesSurvived}}{{else}}0{{/if}}">
        </label>
    </section>

    <p>CAUTION: Saving will overwrite this loadouts pre-existing information</p>
    <button type="submit" class="save-loadout">SAVE LOADOUT</button>
</form>